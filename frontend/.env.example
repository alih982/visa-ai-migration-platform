# ============================================================
# Production Environment Configuration for Runflare Deployment
# ============================================================
# Service URLs:
#   Backend API:  magicai.runflare.run
#   Frontend:     maggicaihub.com
#   AI Service:   magggicai-magicai.runflare.run
# ============================================================

# ===================
# Django Core
# ===================
DEBUG=False
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-THIS-SHOULD-BE-A-LONG-RANDOM-STRING
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=magicai.runflare.run,magggicai-magicai.runflare.run,localhost,127.0.0.1

# ===================
# Database (PostgreSQL on Runflare)
# ===================
DB_NAME=postgreshif_db
DB_USER=postgres
DB_PASSWORD=ppIdIZfPaBTFn5h1v8kx
DB_HOST=remote-pishgaman.runflare.com
DB_PORT=32686
DB_SSL_MODE=prefer
DB_CONN_MAX_AGE=600

# ===================
# Redis (Runflare managed Redis)
# ===================
REDIS_URL=redis://:fEUangL9F7SakzTeMc2l@remote-pishgaman.runflare.com:30534/0
CACHE_URL=redis://:fEUangL9F7SakzTeMc2l@remote-pishgaman.runflare.com:30534/1

# ===================
# Celery
# ===================
CELERY_BROKER_URL=redis://:fEUangL9F7SakzTeMc2l@remote-pishgaman.runflare.com:30534/0
CELERY_RESULT_BACKEND=redis://:fEUangL9F7SakzTeMc2l@remote-pishgaman.runflare.com:30534/0
CELERY_TIMEZONE=Asia/Tehran

# ===================
# CORS & Security
# ===================
CORS_ALLOWED_ORIGINS=http://maggicaihub.com,http://www.maggicaihub.com,http://magicai.runflare.run,http://magggicai-magicai.runflare.run,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
CSRF_TRUSTED_ORIGINS=http://maggicaihub.com,http://www.maggicaihub.com,http://magicai.runflare.run,http://magggicai-magicai.runflare.run,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
CORS_ALLOW_CREDENTIALS=True

# ===================
# AI Service
# ===================
AI_PROVIDER=gateway
AI_SERVICE_URL=http://magggicai-magicai.runflare.run
AI_MODEL_NAME=gemma
OLLAMA_HOST=http://localhost:11434

# ===================
# Frontend (Next.js)
# ===================
NEXT_PUBLIC_API_URL=http://magicai.runflare.run/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://magggicai-magicai.runflare.run
NEXT_PUBLIC_WS_URL=wss://magicai.runflare.run/ws
NEXT_PUBLIC_APP_URL=http://maggicaihub.com
NEXT_PUBLIC_APP_NAME=Smart Health
NEXT_PUBLIC_DEFAULT_LOCALE=fa
NEXT_PUBLIC_SUPPORTED_LOCALES=fa,en

# ===================
# Email (Configure for production)
# ===================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ===================
# Logging
# ===================
LOG_LEVEL=INFO

